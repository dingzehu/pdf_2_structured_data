# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API key — get one at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL connection string (matches the db service in docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/pdf_extractions

# Postgres credentials (used by the db Docker service itself)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=pdf_extractions
